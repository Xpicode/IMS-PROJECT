# Copy to .env for local development. Never commit a real .env.

# --- Database -------------------------------------------------------------
# Local dev: Postgres from compose.dev.yaml is published on 127.0.0.1:5433
# (5433 avoids clashing with a locally installed Postgres on 5432).
# Inside the dev web container the host is "db" and the port 5432; compose.dev.yaml sets that itself.
POSTGRES_PASSWORD=change-me-dev-only
DATABASE_URL=postgresql://ims_app:change-me-dev-only@localhost:5433/ims?schema=public

# Separate database used by integration tests (created automatically by compose.dev.yaml).
TEST_DATABASE_URL=postgresql://ims_app:change-me-dev-only@localhost:5433/ims_test?schema=public

# --- Auth -----------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string
# Public base URL of the app. Behind NGINX in production set the real https URL.
AUTH_URL=http://localhost:3000/api/v1/auth
AUTH_TRUST_HOST=true

# --- App ------------------------------------------------------------------
# Company timezone used for display (§9.2). Database stores UTC.
NEXT_PUBLIC_COMPANY_TIMEZONE=Asia/Manila

# --- Seed (non-production only) ------------------------------------------
# Password given to the three seeded demo users.
SEED_PASSWORD=Demo-Password-2026

# Printed on official forms (Phase 5) until the real header/logo arrives.
COMPANY_NAME="Your Company Inc."
COMPANY_ADDRESS=""
# Where official PDFs are kept (private; default ims/storage/documents).
# DOCUMENTS_DIR=
