{
  "name": "ims",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-zxing.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-zxing.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p sw/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "db:up": "docker compose -f compose.dev.yaml up -d --wait db",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:new-migration": "prisma migrate dev --create-only"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.1",
    "@node-rs/argon2": "^2.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@serwist/turbopack": "^9.5.13",
    "barcode-detector": "^3.2.3",
    "bwip-js": "^4.11.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dexie": "^4.4.7",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "^6.2.6",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "@serwist/build": {
      "zod": "$zod"
    },
    "@serwist/turbopack": {
      "zod": "$zod"
    }
  }
}
