// IMS database schema.
// Spec: IMS_MVP.md §9. Tables are added in the phase that needs them
// (IMS_BUILD_PLAN.md Phase 1: users, user_locations, locations, categories,
// units, audit_events + auth/idempotency support tables).
//
// Conventions
// - UUID primary keys (§9.2); human-readable codes for display.
// - Timestamps are stored in UTC (timestamptz).
// - No destructive deletes for historical records: use isActive / status.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPERVISOR
  FIELD
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum LocationType {
  WAREHOUSE
  SITE
  AREA
}

/// FULL = may act at the location (within the role's permissions).
/// VIEW_ONLY = may read records at the location but not change them.
enum LocationAccess {
  FULL
  VIEW_ONLY
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(120)
  /// Stored lower-cased and trimmed.
  email        String     @unique @db.VarChar(254)
  passwordHash String     @map("password_hash")
  role         Role
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  locations        UserLocation[]
  sessions         Session[]
  auditEvents      AuditEvent[]           @relation("AuditActor")
  resetTokens      PasswordResetToken[]   @relation("ResetTokenUser")
  issuedResets     PasswordResetToken[]   @relation("ResetTokenIssuer")
  idempotencyKeys  IdempotencyKey[]
  stockTxns        StockTransaction[]
  assetEvents      AssetEvent[]
  countsCreated    CountSession[]
  countAssignments CountSessionAssignee[]
  countEntries     CountEntry[]

  @@map("users")
}

/// Server-side login sessions. The browser cookie holds only an opaque random
/// token; we store its SHA-256. Deleting a row ends that session immediately
/// (logout, deactivation, role/location/password change). See lib/auth.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  userAgent  String?  @map("user_agent") @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model UserLocation {
  userId     String         @map("user_id") @db.Uuid
  locationId String         @map("location_id") @db.Uuid
  access     LocationAccess @default(FULL)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([userId, locationId])
  @@index([locationId])
  @@map("user_locations")
}

model Location {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(40)
  name      String       @db.VarChar(120)
  type      LocationType
  parentId  String?      @map("parent_id") @db.Uuid
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent        Location?        @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Location[]       @relation("LocationTree")
  users         UserLocation[]
  balances      StockBalance[]
  movements     StockMovement[]
  assets        Asset[]
  identifiers   ItemIdentifier[]
  countSessions CountSession[]

  @@index([parentId])
  @@map("locations")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items Item[]

  @@map("categories")
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(60)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items Item[]

  @@map("units")
}

/// Append-only. Never update or delete rows (§9.1, §16).
model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(80)
  recordType String?  @map("record_type") @db.VarChar(60)
  recordId   String?  @map("record_id") @db.VarChar(64)
  /// Safe details only. Never passwords, hashes, or tokens.
  before     Json?
  after      Json?
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([recordType, recordId])
  @@index([createdAt])
  @@map("audit_events")
}

/// Admin-issued, single-use, time-limited reset links (§16: no passwords by email).
model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// SHA-256 of the raw token. The raw token is only shown once to the admin.
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User @relation("ResetTokenUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User @relation("ResetTokenIssuer", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Online idempotency for confirm endpoints (§12.4). Offline sync uses
/// sync_operations (Phase 4) instead.
model IdempotencyKey {
  userId         String   @map("user_id") @db.Uuid
  key            String   @db.Uuid
  /// e.g. "POST /api/v1/stock/issues"
  scope          String   @db.VarChar(120)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Phase 2: stock and assets (spec §6, §9)
// ---------------------------------------------------------------------------

/// STOCK = counted in quantities with balances per location.
/// ASSET = each physical unit is an individual asset record with a tag.
enum TrackingType {
  STOCK
  ASSET
}

enum AssetStatus {
  AVAILABLE
  BORROWED
  UNDER_MAINTENANCE
  NEEDS_REVIEW
  LOST
  RETIRED
}

/// Placeholder scale until the company confirms its condition terms (Phase 0).
enum AssetCondition {
  GOOD
  FAIR
  DAMAGED
}

enum StockTxnType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
}

enum StockTxnStatus {
  CONFIRMED
}

/// Kind of printed or manufacturer code.
enum IdentifierKind {
  QR
  CODE128
  EAN13
  UPCA
  OTHER
}

model Item {
  id           String       @id @default(uuid()) @db.Uuid
  /// Stored upper-case and trimmed.
  sku          String       @unique @db.VarChar(40)
  name         String       @db.VarChar(160)
  description  String?      @db.VarChar(1000)
  categoryId   String?      @map("category_id") @db.Uuid
  unitId       String       @map("unit_id") @db.Uuid
  trackingType TrackingType @map("tracking_type")
  /// Low-stock threshold, in whole units (STOCK items only).
  minStock     Int          @default(0) @map("min_stock")
  brand        String?      @db.VarChar(80)
  model        String?      @db.VarChar(80)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit        Unit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  balances    StockBalance[]
  movements   StockMovement[]
  assets      Asset[]
  identifiers ItemIdentifier[]

  countTargets CountSessionItem[]

  @@index([categoryId])
  @@index([name])
  @@map("items")
}

/// Alternate codes (manufacturer barcodes, old labels) for an item, asset, or location.
/// Exactly one target is set. An active code is unique within its namespace (§6.3).
model ItemIdentifier {
  id         String         @id @default(uuid()) @db.Uuid
  /// e.g. "MFR" for manufacturer barcodes, "LEGACY" for old in-house labels.
  namespace  String         @db.VarChar(20)
  /// Normalized: trimmed, upper-case, inner spaces removed.
  code       String         @db.VarChar(100)
  kind       IdentifierKind
  itemId     String?        @map("item_id") @db.Uuid
  assetId    String?        @map("asset_id") @db.Uuid
  locationId String?        @map("location_id") @db.Uuid
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  item     Item?     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  asset    Asset?    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([code])
  @@index([itemId])
  @@index([assetId])
  @@map("item_identifiers")
}

model Asset {
  id            String         @id @default(uuid()) @db.Uuid
  /// Human tag printed on the label, e.g. TOOL-0001. Upper-case, unique.
  tag           String         @unique @db.VarChar(40)
  itemId        String         @map("item_id") @db.Uuid
  serialNumber  String?        @map("serial_number") @db.VarChar(100)
  locationId    String         @map("location_id") @db.Uuid
  /// Who holds it now (person or team). Structured custody arrives with borrowing (Phase 5).
  custodianName String?        @map("custodian_name") @db.VarChar(120)
  status        AssetStatus    @default(AVAILABLE)
  condition     AssetCondition @default(GOOD)
  notes         String?        @db.VarChar(1000)
  /// Optimistic concurrency: bumped on every change.
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  item        Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location    Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  events      AssetEvent[]
  identifiers ItemIdentifier[]

  countTargets CountSessionItem[] @relation("CountTargetAsset")

  @@index([itemId])
  @@index([locationId, status])
  @@index([serialNumber])
  @@map("assets")
}

/// Append-only custody/status/condition history for an asset.
model AssetEvent {
  id             String          @id @default(uuid()) @db.Uuid
  assetId        String          @map("asset_id") @db.Uuid
  /// CREATED, STATUS_CHANGED, DETAILS_CHANGED, ...
  eventType      String          @map("event_type") @db.VarChar(40)
  fromStatus     AssetStatus?    @map("from_status")
  toStatus       AssetStatus?    @map("to_status")
  fromLocationId String?         @map("from_location_id") @db.Uuid
  toLocationId   String?         @map("to_location_id") @db.Uuid
  fromCustodian  String?         @map("from_custodian") @db.VarChar(120)
  toCustodian    String?         @map("to_custodian") @db.VarChar(120)
  fromCondition  AssetCondition? @map("from_condition")
  toCondition    AssetCondition? @map("to_condition")
  notes          String?         @db.VarChar(1000)
  actorId        String          @map("actor_id") @db.Uuid
  requestId      String?         @map("request_id") @db.VarChar(64)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  actor User  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([assetId, createdAt])
  @@map("asset_events")
}

/// Fast current balance per (item, location). Never edited directly: only the
/// stock services change it, always together with a ledger movement (§9).
model StockBalance {
  itemId     String   @map("item_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  quantity   Int      @default(0)
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([itemId, locationId])
  @@index([locationId])
  @@map("stock_balances")
}

model StockTransaction {
  id            String         @id @default(uuid()) @db.Uuid
  /// Server-generated, e.g. ISS-2026-000123 (§12.4).
  reference     String         @unique @db.VarChar(30)
  type          StockTxnType
  status        StockTxnStatus @default(CONFIRMED)
  /// Issue: purpose. Transfer/adjustment: reason.
  reason        String?        @db.VarChar(300)
  /// Receipt: where it came from (supplier, project, return…).
  source        String?        @db.VarChar(160)
  /// Receipt: delivery note / PO number printed on the paperwork.
  externalRef   String?        @map("external_ref") @db.VarChar(80)
  /// Issue: who received the stock.
  recipientName String?        @map("recipient_name") @db.VarChar(120)
  notes         String?        @db.VarChar(1000)
  actorId       String         @map("actor_id") @db.Uuid
  requestId     String?        @map("request_id") @db.VarChar(64)
  confirmedAt   DateTime       @default(now()) @map("confirmed_at") @db.Timestamptz(3)

  actor     User            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@index([type, confirmedAt])
  @@index([confirmedAt])
  @@map("stock_transactions")
}

/// Immutable ledger line: signed quantity at one location (§9.1).
model StockMovement {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  itemId        String   @map("item_id") @db.Uuid
  locationId    String   @map("location_id") @db.Uuid
  quantity      Int
  /// Balance at this location right after this movement (for readable history).
  balanceAfter  Int      @map("balance_after")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction StockTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  item        Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location    Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([itemId, createdAt])
  @@index([locationId, createdAt])
  @@index([transactionId])
  @@map("stock_movements")
}

/// Next number per document type and year, incremented inside the confirming
/// transaction (§9.1). Also used for asset tag series (year 0).
model DocumentSequence {
  docType String @map("doc_type") @db.VarChar(30)
  year    Int
  next    Int    @default(1)

  @@id([docType, year])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Phase 3: physical counts (spec §7.7, §9.1). Count entries arrive through
// sync in Phase 4; Phase 3 only creates sessions and lets devices download them.
// ---------------------------------------------------------------------------

enum CountSessionStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum CountTargetKind {
  STOCK
  ASSET
}

enum CountEntryStatus {
  SUBMITTED
  ACCEPTED
  SUPERSEDED
  REJECTED
}

model CountSession {
  id          String             @id @default(uuid()) @db.Uuid
  reference   String             @unique @db.VarChar(30)
  name        String             @db.VarChar(120)
  locationId  String             @map("location_id") @db.Uuid
  status      CountSessionStatus @default(OPEN)
  dueAt       DateTime?          @map("due_at") @db.Timestamptz(3)
  /// When expected quantities were copied from the live balances.
  snapshotAt  DateTime           @default(now()) @map("snapshot_at") @db.Timestamptz(3)
  version     Int                @default(1)
  notes       String?            @db.VarChar(1000)
  createdById String             @map("created_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  closedAt    DateTime?          @map("closed_at") @db.Timestamptz(3)

  location  Location               @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assignees CountSessionAssignee[]
  targets   CountSessionItem[]
  entries   CountEntry[]

  @@index([locationId, status])
  @@map("count_sessions")
}

model CountSessionAssignee {
  sessionId String @map("session_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  session CountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([sessionId, userId])
  @@index([userId])
  @@map("count_session_assignees")
}

/// One thing to count in a session: a stock item (quantity) or one asset (found / not found).
model CountSessionItem {
  id               String          @id @default(uuid()) @db.Uuid
  sessionId        String          @map("session_id") @db.Uuid
  kind             CountTargetKind
  itemId           String          @map("item_id") @db.Uuid
  assetId          String?         @map("asset_id") @db.Uuid
  /// Snapshot for the reviewer. Never sent to counting devices (blind count).
  expectedQuantity Int?            @map("expected_quantity")
  expectedStatus   AssetStatus?    @map("expected_status")
  version          Int             @default(1)

  session CountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item    Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  asset   Asset?       @relation("CountTargetAsset", fields: [assetId], references: [id], onDelete: Restrict)
  entries CountEntry[]

  @@index([sessionId])
  @@map("count_session_items")
}

/// A submitted observation from a device (written by sync in Phase 4).
model CountEntry {
  id               String           @id @default(uuid()) @db.Uuid
  sessionId        String           @map("session_id") @db.Uuid
  sessionItemId    String           @map("session_item_id") @db.Uuid
  counterId        String           @map("counter_id") @db.Uuid
  quantity         Int?
  found            Boolean?
  condition        AssetCondition?
  notes            String?          @db.VarChar(1000)
  baseVersion      Int              @map("base_version")
  status           CountEntryStatus @default(SUBMITTED)
  operationId      String           @map("operation_id") @db.Uuid
  deviceId         String?          @map("device_id") @db.VarChar(64)
  clientRecordedAt DateTime?        @map("client_recorded_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  session CountSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  target  CountSessionItem @relation(fields: [sessionItemId], references: [id], onDelete: Restrict)
  counter User             @relation(fields: [counterId], references: [id], onDelete: Restrict)

  @@unique([counterId, operationId])
  @@index([sessionId, sessionItemId])
  @@map("count_entries")
}
